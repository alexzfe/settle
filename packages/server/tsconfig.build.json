{
  // The image's build: the shipped code only, without tests, their helpers or maps.
  // tsconfig.json still builds and type-checks everything for development and CI.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "sourceMap": false,
    "declarationMap": false
  },
  "exclude": ["src/**/*.test.ts", "src/testing.ts"],
  "references": [{ "path": "../core/tsconfig.build.json" }]
}
