{
  "name": "int-design-harness",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names server,web --prefix-colors blue,magenta \"pnpm --filter @idh/server dev\" \"pnpm --filter @idh/web dev\"",
    "build": "pnpm --recursive build",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "plugin:build": "pnpm --filter @idh/skills build",
    "plugin:eval": "claude plugin eval ./plugin",
    "start": "pnpm --filter @idh/server start"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "concurrently": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
