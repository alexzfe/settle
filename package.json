{
  "name": "settle",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names server,web --prefix-colors blue,magenta \"pnpm --filter @settle/server dev\" \"pnpm --filter @settle/web dev\"",
    "build": "pnpm --recursive build",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "plugin:build": "pnpm --filter @settle/skills build",
    "plugin:eval": "claude plugin eval ./plugin --trust-plugin --ablation none --no-publish --model claude-sonnet-5",
    "plugin:eval:live": "bash scripts/plugin-eval-live.sh",
    "start": "pnpm --filter @settle/server start"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "concurrently": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
